NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Jotform — formulario «Check-in semanal»
JOTFORM_API_KEY=
JOTFORM_FORM_ID=262472622960055
JOTFORM_API_BASE=https://eu-api.jotform.com  # tu cuenta está en EU Safe mode
JOTFORM_TZ_OFFSET=+01:00                     # zona horaria de tu cuenta Jotform (created_at viene sin zona)
JOTFORM_WEBHOOK_TOKEN=                       # cadena aleatoria larga: openssl rand -hex 32

# CRM (Google Sheets)
CRM_WEBHOOK_SECRET=                          # openssl rand -hex 32 (igual en el Apps Script)
CRM_SPREADSHEET_ID=1EOgTdNx90GuntqB1za-4Ju9wfB2_MvnA3QLPJO-Ys90
